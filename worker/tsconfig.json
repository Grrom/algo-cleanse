{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "../patterns/patterns.json",
    "../docs/privacy.md"
  ]
}
